{
  "name": "@ancore/relayer",
  "version": "0.1.0",
  "description": "Relayer API service for Ancore smart account operations",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "jest --coverage",
    "lint": "eslint src/"
  },
  "keywords": ["ancore", "relayer", "stellar", "soroban"],
  "license": "Apache-2.0",
  "dependencies": {
    "@ancore/stellar": "workspace:*",
    "@ancore/types": "workspace:*",
    "@stellar/stellar-sdk": "^13.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/**/*.test.ts", "**/tests/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    }
  }
}
