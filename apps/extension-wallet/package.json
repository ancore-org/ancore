{
  "name": "@ancore/extension-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../.. --filter @ancore/ui-kit build",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest": "pnpm --dir ../.. --filter @ancore/ui-kit build",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:translations": "node scripts/lint-translations.mjs",
    "e2e": "playwright test --config=tests/playwright.config.ts --grep @smoke",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=tests/playwright.config.ts --grep @smoke",
    "test:e2e:smoke:debug": "playwright test --config=tests/playwright.config.ts --grep @smoke --headed --workers=1 --project=chromium --trace=on",
    "test:e2e:visual": "playwright test --config=tests/playwright.visual.config.ts",
    "test:e2e:ui": "playwright test --config=tests/playwright.config.ts --ui",
    "analyze": "node scripts/analyze-bundle.js",
    "check:csp": "node scripts/check-csp.js",
    "typecheck": "tsc --noEmit",
    "sync:wasm": "node scripts/sync-account-wasm.mjs"
  },
  "dependencies": {
    "@ancore/account-abstraction": "workspace:*",
    "@ancore/core-sdk": "workspace:*",
    "@ancore/crypto": "workspace:*",
    "@ancore/stellar": "workspace:*",
    "@ancore/types": "workspace:*",
    "@ancore/ui-kit": "workspace:*",
    "@ancore/wallet-shared": "workspace:*",
    "@blockaid/client": "^1.8.0",
    "@ledgerhq/hw-app-str": "^7.7.7",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@noble/hashes": "2",
    "@stellar/stellar-sdk": "^17.1.0",
    "bip39": "^3.1.0",
    "buffer": "6",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.4.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^1.0.0"
  }
}
