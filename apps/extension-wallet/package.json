{
  "name": "@ancore/extension-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "pnpm --dir ../.. --filter @ancore/ui-kit build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=tests/playwright.config.ts --grep @smoke",
    "test:e2e:smoke:debug": "playwright test --config=tests/playwright.config.ts --grep @smoke --headed --workers=1 --project=chromium --trace=on",
    "analyze": "node scripts/analyze-bundle.js"
  },
  "dependencies": {
    "@ancore/account-abstraction": "workspace:*",
    "@ancore/core-sdk": "workspace:*",
    "@ancore/crypto": "workspace:*",
    "@ancore/stellar": "workspace:*",
    "@ancore/types": "workspace:*",
    "@ancore/ui-kit": "workspace:*",
    "@stellar/stellar-sdk": "^15.0.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.11.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.14.2",
    "webextension-polyfill": "^0.12.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/webextension-polyfill": "^0.12.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.4.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
