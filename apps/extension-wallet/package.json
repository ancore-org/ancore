{
  "name": "@ancore/extension-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../.. --filter @ancore/ui-kit build",
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest": "pnpm --dir ../.. --filter @ancore/ui-kit build",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:translations": "node scripts/lint-translations.mjs",
    "e2e": "playwright test --config=tests/playwright.config.ts --grep @smoke",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:e2e:smoke": "playwright test --config=tests/playwright.config.ts --grep @smoke",
    "test:e2e:smoke:debug": "playwright test --config=tests/playwright.config.ts --grep @smoke --headed --workers=1 --project=chromium --trace=on",
    "test:e2e:visual": "playwright test --config=tests/playwright.visual.config.ts",
    "test:e2e:ui": "playwright test --config=tests/playwright.config.ts --ui",
    "analyze": "node scripts/analyze-bundle.js",
    "check:csp": "node scripts/check-csp.js",
    "typecheck": "tsc --noEmit",
    "sync:wasm": "node scripts/sync-account-wasm.mjs"
  },
  "dependencies": {
    "@ancore/account-abstraction": "workspace:*",
    "@ancore/core-sdk": "workspace:*",
    "@ancore/crypto": "workspace:*",
    "@ancore/stellar": "workspace:*",
    "@ancore/types": "workspace:*",
    "@ancore/ui-kit": "workspace:*",
    "@ancore/wallet-shared": "workspace:*",
    "@blockaid/client": "^1.4.0",
    "@ledgerhq/hw-app-str": "^7.7.4",
    "@ledgerhq/hw-transport-webhid": "^6.29.3",
    "@noble/hashes": "1",
    "@stellar/stellar-sdk": "^13.3.0",
    "bip39": "^3.1.0",
    "buffer": "6",
    "date-fns": "^4.1.0",
    "i18next": "^24.2.3",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^15.4.1",
    "react-router-dom": "^6.28.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/webextension-polyfill": "^0.12.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.5"
  }
}
