    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.3.0",
    "react-native-screens": "^4.10.0",
    "stream": "^0.0.3",
    "react-native-crypto": "^2.1.0",
    "stream-browserify": "^1.0.0",
    "readable-stream": "1.0.33",
    "react-native-randombytes": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
