{
  "name": "@ancore/mobile-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile wallet MVP shell and security primitives for Ancore",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "dev": "tsc -p ./tsconfig.json --watch",
    "test": "jest --config ./jest.config.cjs --coverage --runInBand",
    "lint": "eslint src/",
    "clean": "rm -rf dist coverage",
    "test:ci": "pnpm run build && pnpm run test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ancore/core-sdk": "workspace:*",
    "@ancore/crypto": "workspace:*",
    "@ancore/stellar": "workspace:*",
    "@ancore/types": "workspace:*",
    "@ancore/wallet-shared": "workspace:*",
    "@reown/walletkit": "^1.5.5",
    "@stellar/stellar-sdk": "^13.3.0",
    "@walletconnect/core": "^2.23.9",
    "@walletconnect/types": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "buffer": "^6.0.3",
    "jail-monkey": "^3.0.0",
    "react": "^18.3.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-keychain": "^10.0.0"
  },
  "peerDependencies": {
    "@walletconnect/react-native-compat": "^2.23.9",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "react": "^18.3.1",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
