{
  "name": "@ancore/crypto",
  "version": "0.1.0",
  "description": "Cryptographic utilities for Ancore",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ancore",
    "crypto",
    "cryptography"
  ],
  "author": "Ancore Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@ancore/types": "workspace:*",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2"
  }
}
