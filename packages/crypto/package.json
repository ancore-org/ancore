{
  "name": "@ancore/crypto",
  "version": "0.1.0",
  "description": "Cryptographic utilities for Ancore",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.build.json",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest --coverage --runInBand",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ancore",
    "crypto",
    "cryptography"
  ],
  "author": "Ancore Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@ancore/types": "workspace:*",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "@stellar/stellar-sdk": "^13.3.0",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bip39": "^3.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
