{
  "name": "@ancore/account-abstraction",
  "version": "0.1.0",
  "description": "Account abstraction primitives for Ancore",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
  "build": "tsup src/index.ts --format cjs,esm --dts --tsconfig tsconfig.json",
  "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
  "test": "jest",
  "lint": "eslint src/",
  "clean": "rm -rf dist"
  },
  "keywords": [
    "ancore",
    "account-abstraction",
    "smart-accounts"
  ],
  "author": "Ancore Contributors",
  "license": "Apache-2.0",
  "dependencies": {
    "@ancore/types": "workspace:*",
    "@ancore/crypto": "workspace:*",
    "@ancore/stellar": "workspace:*",
    "@stellar/stellar-sdk": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.2",
    "ts-jest": "^29.2.0",
    "@types/jest": "^30.0.0"
  }
}
