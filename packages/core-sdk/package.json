{
  "name": "@ancore/core-sdk",
  "version": "0.1.0",
  "description": "Core SDK for building on Ancore",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --tsconfig ./tsconfig.json",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "jest --coverage --runInBand",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:integration": "jest --testPathPattern=integration --no-coverage",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ancore",
    "stellar",
    "soroban",
    "account-abstraction",
    "smart-wallet"
  ],
  "author": "Ancore Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ancore-org/ancore.git",
    "directory": "packages/core-sdk"
  },
  "dependencies": {
    "@ancore/types": "workspace:*",
    "@ancore/account-abstraction": "workspace:*",
    "@ancore/crypto": "workspace:*",
    "@ancore/stellar": "workspace:*",
    "@stellar/stellar-sdk": "^13.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  }
}
