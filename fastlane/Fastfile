default_platform(:ios)

# Absolute, file-relative paths — not dependent on which directory `sh()`
# vs. built-in actions happen to run from (that differs between them and
# has changed across fastlane versions; resolving from `__dir__` sidesteps
# the ambiguity entirely).
MOBILE_APP_DIR = File.expand_path("../apps/mobile-app", __dir__)
IOS_DIR = File.join(MOBILE_APP_DIR, "ios")
ANDROID_DIR = File.join(MOBILE_APP_DIR, "android")
IOS_WORKSPACE = File.join(IOS_DIR, "AncoreWallet.xcworkspace")

# Debug config → org.ancore.wallet.dev, Release config → org.ancore.wallet
# (see apps/mobile-app/ios/AncoreWallet.xcodeproj/project.pbxproj and
# apps/mobile-app/android/app/build.gradle) — the "dual bundle ID" split
# already exists at the native-project level; these lanes just need to
# build/sign/upload the right configuration for the right destination.
IOS_BUNDLE_ID = ENV["IOS_APP_IDENTIFIER"] || "org.ancore.wallet"
ANDROID_PACKAGE_NAME = ENV["ANDROID_PACKAGE_NAME"] || "org.ancore.wallet"

platform :ios do
  desc "Run mobile e2e tests before release"
  lane :e2e_tests do
    UI.message("🧪 Running Maestro e2e tests on iOS simulator...")

    # Ensure maestro is available
    ensure_maestro_installed

    # Run the 3 ready flows
    run_maestro_flow(
      flow: "lock-unlock.yaml",
      description: "Testing lock/unlock cycle"
    )

    run_maestro_flow(
      flow: "walletconnect-pair.yaml",
      description: "Testing WalletConnect pairing"
    )

    run_maestro_flow(
      flow: "sign-xdr.yaml",
      description: "Testing XDR signing via WalletConnect"
    )

    UI.success("✅ All iOS e2e tests passed!")
  end

  desc "Sync the native project's marketing version/build number from apps/mobile-app/package.json"
  lane :sync_version do
    sh("node", File.join(MOBILE_APP_DIR, "scripts/sync-native-version.js"))
  end

  desc "Build and upload the Release configuration to TestFlight (internal testers)"
  lane :beta do |options|
    sync_version
    e2e_tests unless options[:skip_e2e]

    match(
      type: "appstore",
      app_identifier: IOS_BUNDLE_ID,
      readonly: FastlaneCore::Helper.is_ci?,
      # MATCH_GIT_URL / MATCH_PASSWORD (and MATCH_GIT_BASIC_AUTHORIZATION
      # or an SSH deploy key for the certs repo) come from the environment
      # — see .github/workflows/mobile-release.yml and
      # docs/release/mobile-release.md for what CI needs configured.
    )

    build_app(
      workspace: IOS_WORKSPACE,
      scheme: "AncoreWallet",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(IOS_DIR, "build"),
    )

    if options[:dry_run]
      UI.important("🏗️  dry_run: built and signed but skipping upload_to_testflight")
    else
      upload_to_testflight(
        api_key_path: ENV["ASC_API_KEY_PATH"],
        skip_waiting_for_build_processing: true,
        skip_submission: true,
      )
      UI.success("🎉 iOS build uploaded to TestFlight")
    end
  end

  desc "Build and release iOS app (runs e2e gate) — alias kept for backward compatibility"
  lane :release do |options|
    beta(options)
  end

  private_lane :run_maestro_flow do |options|
    flow = options[:flow]
    desc = options[:description]
    env_file = "apps/mobile-app/e2e/common/env.yaml"
    flow_path = "apps/mobile-app/e2e/flows/#{flow}"

    UI.message("  → #{desc}")
    sh(
      "maestro test #{flow_path} --env-file #{env_file} --timeout 600",
      error_callback: ->(result) {
        UI.error("❌ Flow #{flow} failed")
        raise "Maestro e2e test failed: #{flow}"
      }
    )
  end

  private_lane :ensure_maestro_installed do
    unless `which maestro`.empty?
      return
    end
    UI.error("❌ maestro CLI not found")
    UI.message("Install from: https://maestro.mobile/")
    raise "maestro CLI required"
  end
end

platform :android do
  desc "Run mobile e2e tests before release"
  lane :e2e_tests do
    UI.message("🧪 Running Maestro e2e tests on Android emulator...")

    # Ensure maestro is available
    ensure_maestro_installed

    # Run the 3 ready flows
    run_maestro_flow(
      flow: "lock-unlock.yaml",
      description: "Testing lock/unlock cycle"
    )

    run_maestro_flow(
      flow: "walletconnect-pair.yaml",
      description: "Testing WalletConnect pairing"
    )

    run_maestro_flow(
      flow: "sign-xdr.yaml",
      description: "Testing XDR signing via WalletConnect"
    )

    UI.success("✅ All Android e2e tests passed!")
  end

  desc "Sync the native project's versionName/versionCode from apps/mobile-app/package.json"
  lane :sync_version do
    sh("node", File.join(MOBILE_APP_DIR, "scripts/sync-native-version.js"))
  end

  desc "Build and upload the Release build type to the Play internal testing track"
  lane :beta do |options|
    sync_version
    e2e_tests unless options[:skip_e2e]

    # ANCORE_RELEASE_STORE_FILE/PASSWORD/KEY_ALIAS/KEY_PASSWORD must be set
    # (see apps/mobile-app/android/app/build.gradle) — without them the
    # release build type falls back to debug signing, which upload_to_play_store
    # will reject (Play requires a consistent, non-debug signing key per app).
    unless ENV["ANCORE_RELEASE_STORE_FILE"]
      UI.user_error!("ANCORE_RELEASE_STORE_FILE is not set — see docs/release/mobile-release.md for release signing setup")
    end

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: ANDROID_DIR,
    )

    if options[:dry_run]
      UI.important("🏗️  dry_run: built and signed but skipping upload_to_play_store")
    else
      upload_to_play_store(
        track: "internal",
        package_name: ANDROID_PACKAGE_NAME,
        json_key: ENV["GOOGLE_PLAY_JSON_KEY_PATH"],
        aab: File.join(ANDROID_DIR, "app/build/outputs/bundle/release/app-release.aab"),
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
      )
      UI.success("🎉 Android build uploaded to Play internal track")
    end
  end

  desc "Build and release Android app (runs e2e gate) — alias kept for backward compatibility"
  lane :release do |options|
    beta(options)
  end

  private_lane :run_maestro_flow do |options|
    flow = options[:flow]
    desc = options[:description]
    env_file = "apps/mobile-app/e2e/common/env.yaml"
    flow_path = "apps/mobile-app/e2e/flows/#{flow}"

    UI.message("  → #{desc}")
    sh(
      "maestro test #{flow_path} --env-file #{env_file} --timeout 600",
      error_callback: ->(result) {
        UI.error("❌ Flow #{flow} failed")
        raise "Maestro e2e test failed: #{flow}"
      }
    )
  end

  private_lane :ensure_maestro_installed do
    unless `which maestro`.empty?
      return
    end
    UI.error("❌ maestro CLI not found")
    UI.message("Install from: https://maestro.mobile/")
    raise "maestro CLI required"
  end
end
